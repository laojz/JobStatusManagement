APP_DATABASE_PATH=./data/jobs_status.db
APP_DATA_DIR=./data
APP_BOOTSTRAP_USER_EXTERNAL_KEY=local-user
APP_BOOTSTRAP_USER_DISPLAY_NAME=Local User
APP_BOOTSTRAP_MAIL_PROVIDER=local
APP_BOOTSTRAP_MAIL_ACCOUNT_KEY=local-account
APP_BOOTSTRAP_MAIL_DISPLAY_NAME=Local Mail
APP_BOOTSTRAP_MAIL_CREDENTIAL_REF=
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_RUNTIME_MODE=local

# Optional integrations are injected at runtime; empty values keep local demos credential-free.
APP_IMAP_ENABLED=false
APP_IMAP_HOST=imap.qq.com
APP_IMAP_PORT=993
APP_IMAP_SSL=true
APP_IMAP_FOLDER=INBOX
APP_IMAP_ACCOUNT=
APP_IMAP_AUTH_CODE=
APP_IMAP_CONNECT_TIMEOUT_SECONDS=10
APP_IMAP_COMMAND_TIMEOUT_SECONDS=30
APP_IMAP_BATCH_SIZE=100
APP_LLM_ENABLED=false
APP_LLM_BASE_URL=
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-flash
APP_LLM_CONNECT_TIMEOUT_SECONDS=5
APP_LLM_READ_TIMEOUT_SECONDS=60
APP_LLM_WRITE_TIMEOUT_SECONDS=15
APP_LLM_POOL_TIMEOUT_SECONDS=10
APP_LLM_MAX_CONNECTIONS=20
APP_LLM_MAX_KEEPALIVE_CONNECTIONS=10
APP_QQ_ENABLED=false
APP_QQ_ACCESS_TOKEN=
APP_QQ_WEBHOOK_TOKEN=
APP_QQ_USER_OPENID=openid-for-single-user
APP_QQ_APP_ID=
APP_QQ_APP_SECRET=
APP_QQ_API_BASE_URL=https://api.bot.qq.com
# Required with APP_QQ_APP_ID and APP_QQ_APP_SECRET. Set only to an endpoint
# explicitly verified by the operator. The SDK-era bots.qq.com value is an
# unverified legacy fallback, not a production default.
APP_QQ_TOKEN_BASE_URL=
APP_QQ_WEBHOOK_PATH=/webhooks/qq
APP_QQ_REQUEST_TIMEOUT_SECONDS=10
APP_QQ_DISPATCH_TIMESTAMP_MAX_AGE_SECONDS=300
APP_QQ_DOWNLOAD_TIMEOUT_SECONDS=30
APP_QQ_DOWNLOAD_DEADLINE_SECONDS=30
APP_QQ_MAX_DOWNLOAD_BYTES=10485760
APP_AGENT_MAX_TOOL_CALLS=8
APP_AGENT_MAX_RUN_SECONDS=120
APP_AGENT_TOOL_TIMEOUT_SECONDS=10
APP_AGENT_MAX_RESULT_CHARS=12000
APP_AGENT_MAX_DELIVERY_ATTEMPTS=3
APP_MAX_UPLOAD_BYTES=10485760
# APP_EMBEDDING_API_KEY is required with APP_CHROMA_PATH for production indexing; an empty key disables it even when the path is configured.
APP_EMBEDDING_API_KEY=
APP_CHROMA_PATH=./data/chroma
